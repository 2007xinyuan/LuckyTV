<?xml version="1.0" encoding="utf-8"?>
<!-- 护眼休息页：全屏倒计时，结束自动继续播放（无需答题） -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000"
    android:keepScreenOn="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingLeft="80dp"
        android:paddingRight="80dp">

        <TextView
            android:id="@+id/tvBreakTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="眼睛休息一下"
            android:textColor="#FFFFFFFF"
            android:textSize="44sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCountdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="05:00"
            android:textColor="#FF4FC3F7"
            android:textSize="96sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvBreakHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="休息一下，让眼睛放松放松"
            android:textColor="#FFB0BEC5"
            android:textSize="24sp" />

        <!-- 答题区：按返回/OK 想提前继续播放时必须答对 100 以内加减法 -->
        <LinearLayout
            android:id="@+id/llQuiz"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvQuizTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="回答数学题才能提前继续播放"
                android:textColor="#FFFFB74D"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvQuizQuestion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="0 + 0 = ?"
                android:textColor="#FFFFFFFF"
                android:textSize="52sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvQuizInput"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="______"
                android:textColor="#FF4FC3F7"
                android:textSize="40sp" />

            <TextView
                android:id="@+id/tvQuizHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="用遥控器数字键输入答案，OK 确认"
                android:textColor="#FF78909C"
                android:textSize="20sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvSkipHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="40dp"
        android:text="倒计时结束自动继续播放，按返回/OK 可提前结束"
        android:textColor="#FF78909C"
        android:textSize="20sp" />
</RelativeLayout>
